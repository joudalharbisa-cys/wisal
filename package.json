{
  "name": "wesal-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --dir tests/unit",
    "test:rules": "cross-env FIREBASE_EMULATORS_PATH=.firebase-emulators firebase emulators:exec --only firestore --project demo-wesal \"vitest run --dir tests/rules --environment node\"",
    "emulators": "cross-env FIREBASE_EMULATORS_PATH=.firebase-emulators firebase emulators:start --only auth,firestore --project demo-wesal",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules",
    "predeploy": "node scripts/deploy-env.mjs",
    "test:integration": "cross-env FIREBASE_EMULATORS_PATH=.firebase-emulators firebase emulators:exec --only auth,firestore --project demo-wesal \"vitest run --dir tests/integration --environment node\"",
    "seed:emulator": "node scripts/seed-emulator.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/leaflet": "^1.9.23",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "firebase-tools": "^15.37.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18"
  }
}
